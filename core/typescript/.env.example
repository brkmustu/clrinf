# clrinf port scheme: 51703 is the default for the Event Inspector (TypeScript).
PORT=51703
HOST=127.0.0.1
NODE_ENV=development
# Omit for standalone mode; configured NATS must connect before HTTP starts.
# NATS_URL=nats://localhost:51700
# Set a strong token before binding to a non-loopback address.
# INSPECTOR_TOKEN=replace-with-a-secret
# Development containers only (never public deployment):
# INSPECTOR_ALLOW_UNAUTHENTICATED=true
