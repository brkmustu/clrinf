<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>ClrinfCS.Adapters.EfCore</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>EF Core adapter for the ClrinfCS ICrudStore port, scoped by RequestContext tenant.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ClrinfCS.Core/ClrinfCS.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>
</Project>
