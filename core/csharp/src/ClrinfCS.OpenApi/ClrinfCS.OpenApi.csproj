<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClrinfCS.OpenApi</RootNamespace>
    <PackageId>ClrinfCS.OpenApi</PackageId>
    <Version>1.0.0</Version>
    <Authors>dsi</Authors>
    <Description>Native Zero-Dependency OpenAPI v3.0 Specification Generator and UI Middleware for ASP.NET Core</Description>
    <PackageOutputPath>../ClrinfCS/nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="api-docs.html" />
  </ItemGroup>

</Project>
