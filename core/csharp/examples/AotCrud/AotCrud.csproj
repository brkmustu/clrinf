<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot Condition="'$(EnableAotCrudPublish)' == 'true'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>AotCrud</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ClrinfCS.Core/ClrinfCS.Core.csproj" />
    <ProjectReference Include="../../src/ClrinfCS.OpenApi/ClrinfCS.OpenApi.csproj" />
    <ProjectReference Include="../../src/ClrinfCS.Generators/ClrinfCS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
