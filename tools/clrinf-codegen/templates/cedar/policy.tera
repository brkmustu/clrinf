// @clrinf:generated — Multi-Tenant Cedar Policy: {{ domain | default(value="resource") | capitalize }}
// Generated by clrinf-codegen

// 1. Platform Yöneticisi: Kiracılar arası tam denetim yetkisi
permit (
    principal in Role::"PlatformAdmin",
    action,
    resource
);

// 2. Kiracı Yöneticisi: Kendi kiracısındaki kaynaklar üzerinde tam yetki
permit (
    principal in Role::"TenantAdmin",
    action,
    resource in ResourceType::"{{ domain | default(value="resource") | capitalize }}"
) when {
    resource.tenant_id == principal.tenant_id
};

// 3. Modül Yöneticisi: Kendi kiracısında tam CRUD yetkisi
permit (
    principal in Role::"{{ domain | default(value="resource") | capitalize }}Manager",
    action in [
        Action::"{{ domain | default(value="resource") | lower }}.create",
        Action::"{{ domain | default(value="resource") | lower }}.read",
        Action::"{{ domain | default(value="resource") | lower }}.update",
        Action::"{{ domain | default(value="resource") | lower }}.delete"
    ],
    resource in ResourceType::"{{ domain | default(value="resource") | capitalize }}"
) when {
    context.tenant_id == principal.tenant_id &&
    resource.tenant_id == principal.tenant_id
};

// 4. Okuma Rolü: Kendi kiracısında okuma yetkisi
permit (
    principal in Role::"{{ domain | default(value="resource") | capitalize }}Reader",
    action == Action::"{{ domain | default(value="resource") | lower }}.read",
    resource in ResourceType::"{{ domain | default(value="resource") | capitalize }}"
) when {
    context.tenant_id == principal.tenant_id &&
    resource.tenant_id == principal.tenant_id
};

// 5. Kesin Multi-Tenant İzolasyon Muhafızı (Cedar Forbid Guard):
// Kiracı uyuşmazlığı durumunda tüm izin kurallarını ezer ve erişimi engeller
forbid (
    principal,
    action,
    resource in ResourceType::"{{ domain | default(value="resource") | capitalize }}"
) when {
    resource.tenant_id != principal.tenant_id
} unless {
    principal in Role::"PlatformAdmin"
};

